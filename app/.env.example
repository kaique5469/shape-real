# ---------------------------------------------------------------------------
# Shape Real — variáveis de ambiente
# Sem nenhuma variável o app roda em MODO LOCAL: dados ficam no navegador,
# a IA usa o motor determinístico e o modo demonstração fica disponível.
# ---------------------------------------------------------------------------

# Supabase (contas reais, personal ↔ aluno, fotos na nuvem)
# A chave publicável é segura no navegador: o RLS das migrations protege os dados.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IA (geração de fichas, cardápio e análise de dieta). Somente servidor — nunca use NEXT_PUBLIC_.
# Opção 1: chave da Anthropic.
ANTHROPIC_API_KEY=
# Opção 2: Vercel AI Gateway, autenticado pelo token OIDC do próprio deploy (sem chave para guardar).
# Exige um cartão cadastrado em Vercel → AI Gateway para liberar os créditos.
AI_GATEWAY=
# Opcional: modelos e esforço. Padrões: claude-opus-5-5 / anthropic/claude-opus-5.5 / low.
ANTHROPIC_MODEL=
AI_GATEWAY_MODEL=
ANTHROPIC_EFFORT=
# Sem Supabase (modo local/teste) a IA real só responde com DEMO_AI=1.
# TESTER_PASS restringe a IA a quem abriu o link /testar?k=<código>. Limites por IP e por dia:
DEMO_AI=
TESTER_PASS=
DEMO_AI_PER_HOUR=
DEMO_AI_PER_DAY=

# WhatsApp (só dígitos, com DDI) que recebe o feedback do modo teste. Vazio = quem testa escolhe o contato.
NEXT_PUBLIC_FEEDBACK_WHATSAPP=

# Analytics (PostHog). Opcional.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Checkout (links de pagamento — ex.: Stripe Payment Links / Mercado Pago).
# Vazio = botão registra interesse (teste de demanda) em vez de cobrar.
NEXT_PUBLIC_CHECKOUT_PRO_URL=
NEXT_PUBLIC_CHECKOUT_COACH_URL=

# URL pública do app (SEO, links de convite)
NEXT_PUBLIC_SITE_URL=https://app.shapereal.com.br
